# =============================================================================
# FrameFlow — configuración del backend (copia este archivo como .env)
# NUNCA subas .env al repositorio; solo .env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Modo Vertex AI — Google Cloud (PRODUCCIÓN)
# Usa Application Default Credentials (ADC); no se necesita ninguna API key.
# Configura ADC una vez con:
#   gcloud auth application-default login
# En Cloud Run/GKE el service account del entorno se usa automáticamente.
# -----------------------------------------------------------------------------
GEMINI_BACKEND=vertex_ai
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=""
# "global" es requerido para el endpoint global de Vertex AI Gen AI
GOOGLE_CLOUD_LOCATION=global

# -----------------------------------------------------------------------------
# Google Cloud Storage — videos de referencia
# Nombre del bucket (sin gs://). No contiene credenciales; el acceso usa ADC.
# Requerido en producción cuando se habilite la subida de videos.
# Ejemplo: frameflow-reference-videos
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_STORAGE_BUCKET=""

# -----------------------------------------------------------------------------
# Persistencia de tickets
# SQLite es el modo local por defecto. Para Cloud Run usa Firestore en modo
# Native (el filesystem de Cloud Run no conserva el archivo SQLite entre
# instancias). Firestore usa ADC y el mismo GOOGLE_CLOUD_PROJECT de arriba.
# -----------------------------------------------------------------------------
TICKET_STORAGE_BACKEND=sqlite
FIRESTORE_COLLECTION=postproduction_tickets

# Frontend autorizado a llamar a esta API. Para producción añade aquí tu
# dominio de Vercel, separado por comas si mantienes localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3000

