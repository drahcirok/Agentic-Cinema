# =============================================================================
# FrameFlow — configuración del backend (copia este archivo como .env)
# NUNCA subas .env al repositorio; solo .env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Modo Vertex AI — Google Cloud (PRODUCCIÓN)
# Usa Application Default Credentials (ADC); no se necesita ninguna API key.
# Configura ADC una vez con:
#   gcloud auth application-default login
# En Cloud Run/GKE el service account del entorno se usa automáticamente.
# -----------------------------------------------------------------------------
GEMINI_BACKEND=vertex_ai
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=project-06eb2251-0139-4d31-b86
# "global" es requerido para el endpoint global de Vertex AI Gen AI
GOOGLE_CLOUD_LOCATION=global

# -----------------------------------------------------------------------------
# Modo developer — solo para desarrollo local sin Google Cloud
# Descomenta y rellena GEMINI_API_KEY; cambia GEMINI_BACKEND=developer.
# -----------------------------------------------------------------------------
# GEMINI_BACKEND=developer
# GEMINI_API_KEY=pega_tu_clave_aqui
